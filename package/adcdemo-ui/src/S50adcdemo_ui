#!/bin/sh
#
# Starts the ADC demo web server (serves the UI and streams ADC data)
#
NAME=adcdemo_ui
PID_FILE="/var/run/$NAME.pid"

# SERVER=c (default) or SERVER=python (set in /etc/default/adcdemo_ui)
SERVER=c
[ -r /etc/default/$NAME ] && . /etc/default/$NAME

start() {
    printf "Starting adcdemo_ui: "
    if [ "$SERVER" = "python" ]; then
        start-stop-daemon -S -qbm -p $PID_FILE -x /usr/bin/python3 -- /ui/adc_server.py
    else
        start-stop-daemon -S -qbm -p $PID_FILE -x /usr/bin/bvf_adc_server -- \
            -p 80 -d /ui/react-frontend-webgl2/dist -s bvf_adc_stream
    fi
    echo "OK"
}
stop() {
    printf "Stopping adcdemo_ui: "
    start-stop-daemon -K -q -p $PID_FILE
    echo "OK"
}
restart() {
    stop
    start
}

case "$1" in
  start)
	start
	;;
  stop)
	stop
	;;
  restart|reload)
	restart
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
